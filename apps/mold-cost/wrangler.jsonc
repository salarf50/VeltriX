{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veltrix-mold-cost",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veltrix-mold-cost-db",
      "database_id": "5d7059c8-70c2-423f-a8c1-4c2cfd1cf4ac",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    { "binding": "TELEGRAM_BOT", "service": "veltrix-telegram-bot" },
    { "binding": "BALEH_BOT", "service": "veltrix-baleh-bot" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
